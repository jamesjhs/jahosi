# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true
SITE_URL=https://www.jahosi.co.uk
SERVICE_NAME=jahosi
APP_TIMEZONE=Europe/London

# Docker / Traefik deployment
BRANCH_NAME=main
JAHOSI_TRAEFIK_RULE=Host(`jahosi.co.uk`) || Host(`www.jahosi.co.uk`)
JAHOSI_IMAGE=jahosi:local

# Contact form - email addresses
# Address that receives submitted messages
CONTACT_TO_EMAIL=you@example.com
# Display name and address used as the From header on outgoing mail
# Required GitHub variable; use a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <no-reply@example.com>

# Contact form - SMTP settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
# GitHub secrets: SMTP_USER=resend and SMTP_PASS=<Resend API key>
SMTP_USER=resend
SMTP_PASS=

# Contact form - anti-spam (required)
# Cloudflare Turnstile site key and secret key.
# Site key is a GitHub variable; secret key is a GitHub secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Splash chemistry chat (optional)
# When unset, /splash/chat is disabled.
SPLASH_OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. Defaults to https://api.openai.com/v1
SPLASH_OPENAI_BASE_URL=

# Splash chatbot bot-protection (optional)
# Reuses TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY when set.

# Optional Cloudflare Access headers for an Access-protected OpenAI-compatible upstream.
CF-Access-Client-Id=
CF-Access-Client-Secret=

# First-party analytics dashboard
# Protect /analytics/ and /analytics/export.csv at the edge, for example with Cloudflare Access.
# This app does not enforce Cloudflare Access itself.
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=./data/jahosi.sqlite
ANALYTICS_RESPECT_DNT=true
